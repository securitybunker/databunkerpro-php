{
    "name": "securitybunker/databunkerpro-php",
    "description": "PHP client library for DatabunkerPro API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DatabunkerPro Team",
            "email": "hello@databunker.org"
        }
    ],
    "require": {
        "php": ">=7.3",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "DatabunkerPro\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DatabunkerPro\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}
